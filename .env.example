# Public runtime variables (safe to expose in the client bundle)
EXPO_PUBLIC_SUPABASE_URL=https://ilsyvemhdpdizdasubub.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# RevenueCat public SDK keys
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_android_public_sdk_key
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_ios_public_sdk_key

# Optional analytics / crash settings
EXPO_PUBLIC_SENTRY_DSN=https://your-public-dsn.ingest.sentry.io/project-id
EXPO_PUBLIC_SENTRY_SEND_DEFAULT_PII=false
EXPO_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# AdMob app IDs (required to avoid native startup crash when ads SDK is present)
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy

# Optional explicit OAuth redirect override (otherwise derived from your scheme)
EXPO_PUBLIC_SUPABASE_AUTH_REDIRECT_URL=owlapp://auth/callback

# TODO(Google Sign-In): enable the Google provider in Supabase Auth with a
# Google Cloud OAuth Web Client ID and Client Secret. Add this redirect URI to
# Supabase Auth redirect URLs: owlapp://auth/callback
# Add the Supabase Google provider callback URL to Google Cloud Authorized
# redirect URIs: https://<your-supabase-project-ref>.supabase.co/auth/v1/callback
# Optional for Expo web Google sign-in only:
EXPO_PUBLIC_GOOGLE_AUTH_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
